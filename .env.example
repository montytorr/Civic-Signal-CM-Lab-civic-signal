# CivicSignal runtime configuration. On clawdius this lives at
# /home/runner/civicsignal-secrets/web.env (mode 600, owned by runner) and is
# written by scripts/host/write-web-env.sh. Never commit real values.
# Values are unquoted: docker --env-file keeps quotes literally.

# Postgres over the clawdius-data network; the role owns the database.
DATABASE_URL=postgresql://civicsignal_app:change-me@clawdius-postgres:5432/civicsignal
# 64 random bytes, hex: openssl rand -hex 64
SESSION_SECRET=change-me
# Resend key verified for the EMAIL_FROM domain; empty disables email.
RESEND_API_KEY=re_change_me
EMAIL_FROM=CivicSignal <noreply@montytorr.com>
APP_URL=https://civicsignal.montytorr.com
NODE_ENV=production
